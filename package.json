{
  "name": "matronixlauncher",
  "productName": "MatronixLauncher",
  "version": "1.0.0",
  "description": "MatronixLauncher — Minecraft launcher with Ely.by auth, Vanilla/Fabric/Forge, Modrinth and CurseForge mods",
  "main": "electron/main.js",
  "author": "MatronixLauncher",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "org.matronixlauncher",
    "productName": "MatronixLauncher",
    "win": {
      "target": "nsis",
      "arch": "x64",
      "icon": "assets/icon.ico"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
