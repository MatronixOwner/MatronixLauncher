{
  "name": "matronix-launcher",
  "version": "0.1.11",
  "private": true,
  "description": "MatronixLauncher — customizable Minecraft launcher",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "desktop": "electron .",
    "dist:win": "npm run build && electron-builder --win portable --x64 --publish never",
    "dist:win:installer": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@xmcl/core": "^2.15.1",
    "@xmcl/installer": "^6.1.2",
    "undici": "^7.30.1",
    "vite": "^6.0.7",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.matronix.launcher",
    "productName": "MatronixLauncher",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ],
      "artifactName": "MatronixLauncher-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MatronixLauncher",
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "displayLanguageSelector": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "MatronixLauncher-Setup-${version}-win-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "MatronixLauncher-${version}-win-${arch}.${ext}"
    }
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}
